NODE_ENV=development
PORT=3000

# Public JWKS is fetched from Identity unless JWT_PUBLIC_KEY is supplied.
IDENTITY_URL=http://host.docker.internal:3011
JWT_JWKS_URL=http://host.docker.internal:3011/api/v2/.well-known/jwks.json
JWT_PUBLIC_KEY=
JWT_ISSUER=urn:descubreec:identity
JWT_AUDIENCE=urn:descubreec:internal-api

CART_URL=http://host.docker.internal:3008
# Reservations are currently served by ms-catalog in this repository.
BOOKING_URL=http://host.docker.internal:3014
CATALOG_URL=http://host.docker.internal:3014
INVENTORY_URL=http://host.docker.internal:3017
PAYMENT_URL=http://host.docker.internal:3010
AUDIT_URL=http://host.docker.internal:3016

# Internal service prefixes; ingress versions v1/v2/v3 map to these paths.
IDENTITY_API_PREFIX=/api/v2/auth
CART_API_PREFIX=/api/v2/cart
BOOKING_API_PREFIX=/api/v3/atracciones/reservas
CATALOG_API_PREFIX=/api/v2
INVENTORY_API_PREFIX=/api/v2/inventory
PAYMENT_API_PREFIX=/api/v2
AUDIT_API_PREFIX=/api/v2/audit

CORS_ORIGINS=http://localhost:4200,http://localhost:5173
RATE_LIMIT_CUSTOMER=100
RATE_LIMIT_PARTNER=500
RATE_LIMIT_ADMIN=1000
PROXY_TIMEOUT_MS=30000
HEALTH_TIMEOUT_MS=2500
