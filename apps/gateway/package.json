    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.9.0 <25",
