# Referencia: copiar en cada servicio y asignar su propia base/cola.
NODE_ENV=development
SERVICE_NAME=ms_catalog
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/ms_catalog?sslmode=require
DB_POOL_MAX=5

# CloudAMQP: AMQPS obligatorio. Una cola por consumidor/servicio.
AMQP_URL=amqps://USER:PASSWORD@example.rmq.cloudamqp.com/VHOST
AMQP_QUEUE=ms_catalog.events
AMQP_PREFETCH=10

# Railway: destino host:puerto TCP (sin https://).
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
INVENTORY_GRPC_URL=inventory.railway.internal:50051
INVENTORY_GRPC_TLS=false
# Ruta absoluta al contrato al ejecutar el servicio.
INVENTORY_PROTO_PATH=../../contracts/grpc/inventory.proto

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-independent-random-secret
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_API_KEY=replace-with-an-independent-service-secret
BOOKING_API_KEY=replace-with-a-random-booking-consumer-key-at-least-32-characters
# Identity usa RS256 y keyring (JWT_SECRET no se usa en ms_identity).
APP_ENV=local
JWT_KEYRING_PATH=.keys/identity.local.json
JWT_ISSUER=urn:descubreec:identity
JWT_ACCESS_TTL_SECONDS=900
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
IDENTITY_BASE_URL=http://localhost:3011/api/v2
CATALOG_EVENTS_QUEUE=booking.catalog.events
INVENTORY_SERVICE_ID=NODE_ATR_GLORIA

# ms_payment: simulacion opt-in; tasa en [0,1], latencia en ms.
SIMULATION_ENABLED=false
PAYMENT_SIMULATION_FAILURE_RATE=0.35
SAGA_SIMULATION_ENABLED=false
PAYMENT_ALLOW_TEST_PAYLOADS=false
SAGA_EXCHANGE=booking.saga.v1
RESERVATION_TTL_SECONDS=300
CATALOG_BASE_URL=http://localhost:3014/api/v2
INVENTORY_SYNC_API_KEY=replace-with-a-random-sync-key-at-least-32-characters
PAYMENT_SIMULATION_DELAY_MS=500
