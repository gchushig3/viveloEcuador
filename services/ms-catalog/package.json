{
  "name": "ms-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "Catalog & Attractions Service — Descubre EC",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.9.0 <25",
    "npm": ">=11 <13"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test --max-warnings=0",
    "format:check": "prettier --check src test scripts *.json *.mjs *.yaml README.md docs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.config.mjs --runInBand",
    "env:local": "node scripts/prepare-local-env.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "env:test": "node scripts/prepare-local-env.mjs --test",
    "db:apply": "node --env-file=.env scripts/apply-schema.mjs",
    "test:integration": "node --env-file=.env.test --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-integration.config.mjs --runInBand",
    "test:docker-bootstrap": "node scripts/verify-docker-bootstrap.mjs",
    "test:local-stack": "node scripts/verify-local-stack.mjs",
    "openapi:export": "npm run build && node scripts/export-openapi.mjs",
    "openapi:check": "npm run build && node scripts/export-openapi.mjs --check",
    "contracts:generate": "node scripts/generate-booking-schemas.mjs",
    "contracts:check": "node scripts/generate-booking-schemas.mjs --check"
  },
  "dependencies": {
    "@booking/infrastructure": "file:../../packages/shared-infrastructure",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/microservices": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/typeorm": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
