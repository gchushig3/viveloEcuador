NODE_ENV=development
PORT=3018
# Use Neon Console > Connect and choose the pooled connection string.
# Keep sslmode=require in the URL; replace this placeholder with the real value.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/ms_cliente?sslmode=require
DB_POOL_MAX=5
# Set LEGACY_DATABASE_URL temporarily to copy existing cliente_atraccion rows
# from ms-catalog before switching Booking traffic to this service.
# LEGACY_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5444/ms_catalog
# Optional paired sources for already-paid local store buyers:
# LOCAL_IDENTITY_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/ms_identity
# LOCAL_CART_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5445/ms_cart
