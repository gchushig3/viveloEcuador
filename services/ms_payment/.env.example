DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
DB_DATABASE=ms_payment
NODE_ENV=development
SIMULATION_ENABLED=false
# Neon tiene prioridad sobre las variables DB_*.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/ms_payment?sslmode=require
DB_POOL_MAX=5
PORT=3010
AMQP_URL=amqps://USER:PASSWORD@example.rmq.cloudamqp.com/VHOST
SAGA_EXCHANGE=booking.saga.v1
AMQP_AUDIT_QUEUE=booking.audit.events
IDENTITY_BASE_URL=http://localhost:3011/api/v2
BOOKING_API_KEY=replace-with-the-same-booking-key-configured-in-identity
# Simulador Saga explicito; nunca invoca una pasarela real.
SAGA_SIMULATION_ENABLED=false
PAYMENT_SIMULATION_FAILURE_RATE=0.35
PAYMENT_ALLOW_TEST_PAYLOADS=false
