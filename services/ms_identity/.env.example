# Template only. npm run env:local generates .env without overwriting it.
NODE_ENV=development
APP_ENV=local
PORT=3011
DB_HOST=127.0.0.1
DB_PORT=5441
DB_USERNAME=identity_local
DB_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
DB_DATABASE=ms_identity
SMTP_HOST=127.0.0.1
# SMTP_ENABLED=false disables email delivery: SMTP_* become optional and verification/recovery endpoints return 503.
# SMTP_ENABLED=true (default) validates SMTP strictly; production then requires SMTP_USER and SMTP_PASS.
# SMTP_ENABLED=false
SMTP_PORT=1025
SMTP_FROM=noreply@identity.local
# Production SMTP uses implicit TLS on port 465 or required STARTTLS on other ports.
# Configure SMTP_USER and SMTP_PASS as production secrets; never commit their values.
MAILPIT_UI_PORT=8025
CORS_ORIGINS=
# Generate ignored local RSA keys with npm run keys:local.
# Docker sets its own path to the read-only bind mount.
JWT_KEYRING_PATH=.keys/identity.local.json
# Production: use either a mounted JWT_KEYRING_PATH or secret JWT_KEYRING_JSON, not both.
# Never bake RSA private keys into the image or commit them.
JWT_ISSUER=urn:descubreec:identity
JWT_ACCESS_TTL_SECONDS=900
BCRYPT_ROUNDS=12
AUTH_LOGIN_LIMIT=5
AUTH_RECOVERY_LIMIT=3
# Neon: al definir DATABASE_URL, reemplaza DB_HOST/PORT/USERNAME/PASSWORD/DATABASE.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/ms_identity?sslmode=require
DB_POOL_MAX=5
# Compartir esta clave con consumidores autorizados; nunca con el navegador.
BOOKING_API_KEY=replace-with-a-random-booking-consumer-key-at-least-32-characters
# ADMIN: npm run admin:prepare -- --email your-admin@example.test
# Explicit CLI only; credentials go into ignored .env.admin.local, never this file.
