{
  "name": "ms-identity",
  "version": "0.1.0",
  "description": "Identity & Access Service - Descubre EC",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --check src test scripts *.json *.mjs *.yaml README.md docs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.mjs --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.config.mjs --runInBand",
    "env:local": "node scripts/prepare-local-env.mjs",
    "env:test": "node scripts/prepare-local-env.mjs --test",
    "test:local-stack": "node scripts/verify-phase-f.mjs",
    "db:apply": "node --env-file=.env scripts/apply-schema.mjs",
    "db:apply:test": "node --env-file=.env.test scripts/apply-schema.mjs",
    "test:integration": "node --env-file=.env.test --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-integration.config.mjs --runInBand",
    "test:docker-bootstrap": "node scripts/verify-docker-bootstrap.mjs",
    "keys:local": "node scripts/prepare-local-keys.mjs",
    "keys:test": "node scripts/prepare-local-keys.mjs --test",
    "keys:rotate": "node scripts/prepare-local-keys.mjs --rotate",
    "admin:prepare": "node scripts/prepare-admin.mjs",
    "admin:bootstrap": "node --env-file=.env --env-file=.env.admin.local scripts/bootstrap-admin.mjs",
    "openapi:export": "node --env-file=.env scripts/export-openapi.mjs",
    "openapi:check": "node --env-file=.env scripts/export-openapi.mjs --check",
    "test:swagger-browser": "node scripts/verify-swagger-browser.mjs",
    "verify:local": "node scripts/verify-phase-g.mjs"
  },
  "dependencies": {
    "@booking/infrastructure": "file:../../packages/shared-infrastructure",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/microservices": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/typeorm": "12.0.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jose": "6.2.13",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.6.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.9.0 <25",
    "npm": ">=11 <13"
  },
  "scarfSettings": {
    "enabled": false
  }
}
