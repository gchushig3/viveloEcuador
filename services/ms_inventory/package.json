{
  "name": "ms_inventory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:dev": "tsc -p tsconfig.json && node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\"",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "start:prod": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@booking/infrastructure": "file:../../packages/shared-infrastructure",
    "@grpc/grpc-js": "^1.14.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/microservices": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "12.0.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  }
}
